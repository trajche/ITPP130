#include <font.defs>
#include <media.defs>

{
  Manufacturer "MUNBYN"
  ModelName "ITPP130"
  PCFileName "munbyn-itpp130.ppd"
  Version 1.0
  DriverType label
  ManualCopies Yes
  ColorDevice No
  Throughput 1
  Filter application/vnd.cups-raster 0 rastertotspl

  // 8-bit grayscale raster, white = 255; the filter thresholds to 1-bit.
  ColorModel Gray/Grayscale w chunky 0
  *Resolution w 8 0 0 0 "203dpi/203 DPI"

  HWMargins 0 0 0 0
  VariablePaperSize Yes
  MinSize 36 18
  MaxSize 306 2880

